<mxfile host="app.diagrams.net" type="device"><diagram id="system-a1" name="A.1. Схема системы"><mxGraphModel dx="1480" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="940" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="client" value="&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;&lt;br&gt;Приложение на телефоне&lt;br&gt;Сканирование QR&lt;br&gt;Выбор чаевых&lt;br&gt;Подтверждение / отмена" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="270" height="200" as="geometry" /></mxCell><mxCell id="platform" value="&lt;b&gt;Платформа&lt;/b&gt;&lt;br&gt;&lt;br&gt;Проверки QR и сумм&lt;br&gt;Расчёт чаевых и итога&lt;br&gt;Создание и статусы платежа&lt;br&gt;Идемпотентность / резерв QR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="200" width="360" height="200" as="geometry" /></mxCell><mxCell id="gateway" value="&lt;b&gt;Эмулятор шлюза&lt;/b&gt;&lt;br&gt;&lt;br&gt;h = MD5(qr_id + nonce) mod 10&lt;br&gt;0–7: успех; 8: отказ&lt;br&gt;9: тайм-аут&lt;br&gt;Без реального списания" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=12;" vertex="1" parent="1"><mxGeometry x="1160" y="200" width="290" height="200" as="geometry" /></mxCell><mxCell id="store" value="&lt;b&gt;Хранилище&lt;/b&gt;&lt;br&gt;&lt;br&gt;merchants / employees / qr_links&lt;br&gt;payments.csv — история&lt;br&gt;payments_out.csv — результат&lt;br&gt;Ключи и резервы — проектные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=12;" vertex="1" parent="1"><mxGeometry x="330" y="670" width="390" height="190" as="geometry" /></mxCell><mxCell id="audit" value="&lt;b&gt;Аудит&lt;/b&gt;&lt;br&gt;&lt;br&gt;event_id, payment_id, qr_id&lt;br&gt;action, from_status, to_status&lt;br&gt;actor, at&lt;br&gt;Без секретов и реквизитов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E22CE;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=12;" vertex="1" parent="1"><mxGeometry x="1010" y="670" width="400" height="190" as="geometry" /></mxCell><mxCell id="request" value="1–3. QR, выбор чаевых,&lt;br&gt;подтверждение / отмена" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="platform"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint x="0.0" y="-25.0" as="offset" /></mxGeometry></mxCell><mxCell id="response" value="Чек, суммы, payment_id,&lt;br&gt;статус / код ошибки" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.75;exitDx=0;exitDy=0;entryX=1.0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="platform" target="client"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint x="0.0" y="32.0" as="offset" /></mxGeometry></mxCell><mxCell id="pay" value="3. Запрос эмуляции:&lt;br&gt;qr_id, nonce" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=14;fontFamily=Arial;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="platform" target="gateway"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint x="0.0" y="-25.0" as="offset" /></mxGeometry></mxCell><mxCell id="result" value="4. Успех / отказ / тайм-аут&l