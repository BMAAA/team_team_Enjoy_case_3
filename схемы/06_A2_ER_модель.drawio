y="0" relative="1" as="geometry"><mxPoint x="0.0" y="-37.5" as="offset" /></mxGeometry></mxCell><mxCell id="merchant" value="&lt;div style=&quot;text-align:center;font-size:23px;font-weight:bold;&quot;&gt;Merchant&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;line-height:1.65;&quot;&gt;PK merchant_id : string&lt;br&gt;name : string (1–100)&lt;br&gt;status : ACTIVE/BLOCKED/PENDING&lt;br&gt;description : string (0–200)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=16;fontFamily=Consolas;spacing=15;verticalAlign=top;" vertex="1" parent="1" diagramRole="entity"><mxGeometry x="80" y="180" width="430" height="240" as="geometry" /></mxCell><mxCell id="employee" value="&lt;div style=&quot;text-align:center;font-size:23px;font-weight:bold;&quot;&gt;Employee&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;line-height:1.65;&quot;&gt;PK employee_id : string&lt;br&gt;FK merchant_id → Merchant&lt;br&gt;name : string (1–100)&lt;br&gt;payment_details : ****NNNN&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=2;fontSize=16;fontFamily=Consolas;spacing=15;verticalAlign=top;" vertex="1" parent="1" diagramRole="entity"><mxGeometry x="680" y="180" width="430" height="240" as="geometry" /></mxCell><mxCell id="qr" value="&lt;div style=&quot;text-align:center;font-size:23px;font-weight:bold;&quot;&gt;QR&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;line-height:1.65;&quot;&gt;PK qr_id : string&lt;br&gt;FK merchant_id → Merchant&lt;br&gt;FK employee_id → Employee&lt;br&gt;receipt_id : string (r_NNNN)&lt;br&gt;nonce : string (6 hex)&lt;br&gt;exp : datetime UTC (+24 ч)&lt;br&gt;signature : 16 hex HMAC-SHA256&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=2;fontSize=16;fontFamily=Consolas;spacing=15;verticalAlign=top;" vertex="1" parent="1" diagramRole="entity"><mxGeometry x="1280" y="180" width="440" height="360" as="geometry" /></mxCell><mxCell id="report" value="&lt;div style=&quot;text-align:center;font-size:23px;font-weight:bold;&quot;&gt;Report&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;line-height:1.65;&quot;&gt;PK report_id (при сохранении)&lt;br&gt;FK merchant_id → Merchant&lt;br&gt;period : string (YYYY-MM)&lt;br&gt;tips_total : decimal(12,2)&lt;br&gt;payments_count : integer&lt;br&gt;avg_tip_pct : number/null&lt;br&gt;success_rate : number/null&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontSize=16;fontFamily=Consolas;spacing=15;verticalAlign=top;" vertex="1" parent="1" diagramRole="entity"><mxGeometry x="80" y="830" width="430" height="310" as="geometry" /></mxCell><mxCell id="payment" value="&lt;div style=&quot;text-align:center;font-size:23px;font-weight:bold;&quot;&gt;Payment&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;line-height:1.65;&quot;&gt;PK payment_id : string&lt;br&gt;FK qr_id → QR (для новых)&lt;br&gt;merchant_id, employee_id : string&lt;br&gt;amount, tip : decimal(12,2)&lt;br&gt;status : enum (5 состояний)&lt;br&gt;timestamp : datetime UTC&lt;br&gt;idempotency_key : string&lt;br&gt;client_session_id : string&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E22CE;strokeWidth=2;fontSize=16;fontFamily=Consolas;spacing=15;verticalAlign=top;" vertex="1" parent="1" diagramRole="entity"><mxGeometry x="1280" y="800" width="440" height="450" as="geometry" /></mxCell><mxCell id="audit" value="&lt;div style=&quot;text-align:center;font-size:23px;font-weight:bold;&quot;&gt;AuditEvent&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;line-height:1.65;&quot;&gt;PK event_id : string&lt;br&gt;FK payment_id → Payment (null*)&lt;br&gt;qr_id : контекст QR&lt;br&gt;action : enum&lt;br&gt;from_status, to_status : enum/null&lt;br&gt;actor : string; at : datetime UTC&lt;br&gt;amount_total, error_code: контекст&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#BE185D;strokeWidth=2;fontSize=16;fontFamily=Consolas;spacing=15;verticalAlign=top;" vertex="1" parent="1" diagramRole="entity"><mxGeometry x="680" y="830" width="430" height="420" as="geometry" /></mxCell><mxCell id="history" value="Связь QR → Payment обязательна для новых платежей; в историческом payments.csv поля qr_id нет." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=17;fontColor=#475569;fontStyle=0;" vertex="1" parent="1" diagramRole="annotation"><mxGeometry x="365.65" y="1293" width="1068.7" height="37" as="geometry" /></mxCell><mxCell id="nullable" value="* payment_id = null у события отказа до создания платежа. Схема описывает проектную модель." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=17;fontColor=#475569;fontStyle=0;" vertex="1" parent="1" diagramRole="annotation"><mxGeometry x="382.2249999999999" y="1328" width="1035.5500000000002" height="37" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>